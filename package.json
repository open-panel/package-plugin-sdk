{
  "name": "@open-panel/plugin-sdk",
  "version": "0.1.0",
  "description": "The OpenPanel plugin SDK: the plugin.json manifest schema, a plugin registry with per-contribution isolation and live reload, the capability surface (log/shell/http/storage/notify/device), and the adapter that turns plugin actions into ActionDefinitions.",
  "type": "module",
  "license": "MIT",
  "author": "OpenPanel contributors",
  "homepage": "https://github.com/open-panel/package-plugin-sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/open-panel/package-plugin-sdk.git"
  },
  "bugs": {
    "url": "https://github.com/open-panel/package-plugin-sdk/issues"
  },
  "keywords": [
    "openpanel",
    "macropad",
    "stream-deck",
    "plugin",
    "sdk"
  ],
  "sideEffects": false,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run build"
  },
  "dependencies": {
    "@open-panel/action-engine": "^0.1.0",
    "@open-panel/device-sdk": "^0.1.0",
    "@open-panel/shared": "^0.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "tsup": "^8.5.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
